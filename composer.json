{
    "name": "developerbatuhan/wp-context-engine",
    "description": "A native WordPress context engine powering AI for both content creators and site visitors",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-only",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
